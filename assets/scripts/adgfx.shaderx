gfx/2d/ad/poi_attack
{
	nopicmip
	novlcollapse
	{
		map gfx/2d/ad/attack_tint.tga
		blendfunc add
		rgbgen vertex
	}
	{
		map gfx/2d/ad/attack.tga
		blendfunc blend
		rgbgen identity
	}
}

