models/flag3/b_flag3
{
	cull none
	nopicmip

	{
		map models/flag3/b_flag3_tint.jpg
		blendfunc add
		rgbgen identity
	}
	{
		AnimMap 15 models/flag3/flag3_static_1.jpg models/flag3/flag3_static_2.jpg models/flag3/flag3_static_3.jpg models/flag3/flag3_static_4.jpg
		blendfunc add
		rgbGen wave sin 0.5 0.25 0 3
	}
	{
		map models/flag3/flag3.png
		blendfunc blend
		rgbGen wave triangle 0.95 0.05 1 15
	}
}

